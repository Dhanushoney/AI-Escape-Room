# Copy this file to `.env` and fill in your own values. Never commit `.env`.

# Free Google AI Studio key: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_api_key_here

# Any text model your key can access. gemini-3.8-flash was the current stable
# Flash model when this project was written (November 2026).
GEMINI_MODEL=gemini-3.8-flash

# Optional: "gemini" (default when a key is present) or "mock".
# Mock mode needs no key: Version 2 becomes fully playable with its
# rule-based parser and engine narration; Version 1 shows a labelled stub.
LLM_MODE=gemini

# Optional request timeout in seconds
LLM_TIMEOUT_SECONDS=30
